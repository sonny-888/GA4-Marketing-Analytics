RETURN
    IF ( ISBLANK ( _pp ), "#5C667A", IF ( _cur >= _pp, "#4A7336", "#A3434C" ) )
// Format: text


// ---------------------------------------------------------------- PERIOD COMPARISON

[Checkout to Purchase Rate PP] =
VAR _start = MIN ( dim_date[date] )
VAR _days = INT ( MAX ( dim_date[date] ) - _start ) + 1
RETURN
    CALCULATE ( [Checkout to Purchase Rate], DATESBETWEEN ( dim_date[date], _start - _days, _start - 1 ) )
// Format: 0.0%

[Checkout to Purchase Rate Change] =
VAR _cur = [Checkout to Purchase Rate]
VAR _pp = [Checkout to Purchase Rate PP]
RETURN
    IF (
        ISBLANK ( _pp ),
        "No prior period",
        IF ( _cur >= _pp, "▲ ", "▼ " ) & FORMAT ( ABS ( _cur - _pp ) * 100, "0.00" ) & " pts" & " vs previous period"
    )
// Format: text


// ---------------------------------------------------------------- FORMATTING

[Checkout to Purchase Rate Change Color] =
VAR _cur = [Checkout to Purchase Rate]
