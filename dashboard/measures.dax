// Format: text


// ---------------------------------------------------------------- TRAFFIC

[Organic Search Sessions] =
CALCULATE ( [Sessions], dim_channel[channel] = "Organic Search" )
// Format: #,0

[Direct Sessions] =
CALCULATE ( [Sessions], dim_channel[channel] = "Direct" )
// Format: #,0

[Other Sessions] =
[Sessions] - [Organic Search Sessions] - [Direct Sessions]
// Format: #,0

[Session Share] =
DIVIDE ( [Sessions], CALCULATE ( [Sessions], REMOVEFILTERS ( fct_sessions[geo_country] ) ) )
// Format: 0.0%


// ---------------------------------------------------------------- PERIOD COMPARISON

[Sessions vs PP] =
DIVIDE ( [Sessions] - [Sessions PP], [Sessions PP] )
// Format: +0%;-0%;0%


// ---------------------------------------------------------------- SALES

[Revenue per Day] =
DIVIDE ( [Revenue], COUNTROWS ( dim_date ) )
// Format: \$#,0


// ---------------------------------------------------------------- PRODUCTS

[Product Revenue] =
SUM ( fct_order_items[item_revenue_usd] )
// Format: \$#,0

[Units Sold] =
SUM ( fct_order_items[quantity] )
// Format: #,0


// ---------------------------------------------------------------- FUNNEL

[Session to View Rate Remainder] =
IF ( NOT ISBLANK ( [Session to View Rate] ), 1 - [Session to View Rate] )
// Format: 0.0%

[View to Cart Rate Remainder] =
IF ( NOT ISBLANK ( [View to Cart Rate] ), 1 - [View to Cart Rate] )
// Format: 0.0%

[Cart to Checkout Rate Remainder] =
IF ( NOT ISBLANK ( [Cart to Checkout Rate] ), 1 - [Cart to Checkout Rate] )
// Format: 0.0%

[Checkout to Purchase Rate Remainder] =
IF ( NOT ISBLANK ( [Checkout to Purchase Rate] ), 1 - [Checkout to Purchase Rate] )
// Format: 0.0%


// ---------------------------------------------------------------- FORMATTING

[Revenue Change Color Dark] =
VAR _cur = [Revenue]
VAR _pp = [Revenue PP]
RETURN
    IF ( ISBLANK ( _pp ), "#9893B5", IF ( _cur >= _pp, "#4ADE80", "#FF7A90" ) )
// Format: text

[Orders Change Color Dark] =
VAR _cur = [Orders]
VAR _pp = [Orders PP]
RETURN
    IF ( ISBLANK ( _pp ), "#9893B5", IF ( _cur >= _pp, "#4ADE80", "#FF7A90" ) )
// Format: text

[Sessions Change Color Dark] =
VAR _cur = [Sessions]
VAR _pp = [Sessions PP]
RETURN
    IF ( ISBLANK ( _pp ), "#9893B5", IF ( _cur >= _pp, "#4ADE80", "#FF7A90" ) )
// Format: text

[Conversion Rate Change Color Dark] =
VAR _cur = [Conversion Rate]
VAR _pp = [Conversion Rate PP]
RETURN
    IF ( ISBLANK ( _pp ), "#9893B5", IF ( _cur >= _pp, "#4ADE80", "#FF7A90" ) )
// Format: text

[Sunday Highlight Color Dark] =
IF ( SELECTEDVALUE ( dim_date[day_name] ) = "Sun", "#F472B6", "#9C88FF" )
// Format: text
