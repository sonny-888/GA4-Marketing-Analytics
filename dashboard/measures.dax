// Generated by dashboard/build_pbip.py; edit the MEASURES list there, not this file.


// ---------------------------------------------------------------- TRAFFIC

[Sessions] =
COUNTROWS ( fct_sessions )
// Format: #,0

[Users] =
DISTINCTCOUNT ( fct_sessions[user_pseudo_id] )
// Format: #,0

[Engaged Sessions] =
CALCULATE ( [Sessions], fct_sessions[is_engaged] = TRUE () )
// Format: #,0

[Engagement Rate] =
DIVIDE ( [Engaged Sessions], [Sessions] )
// Format: 0.0%

[New User %] =
DIVIDE ( CALCULATE ( [Sessions], fct_sessions[is_new_user_session] = TRUE () ), [Sessions] )
// Format: 0.0%


// ---------------------------------------------------------------- SALES

[Orders] =
COUNTROWS ( fct_orders )
// Format: #,0

[Revenue] =
SUM ( fct_orders[purchase_revenue_usd] )
// Format: \$#,0

[Conversion Rate] =
DIVIDE ( [Orders], [Sessions] )
// Format: 0.00%

[AOV] =
DIVIDE ( [Revenue], [Orders] )
// Format: \$#,0.00

[Revenue per Session] =
DIVIDE ( [Revenue], [Sessions] )
// Format: \$#,0.00


// ---------------------------------------------------------------- FUNNEL

[Funnel Base Sessions] =
CALCULATE ( [Sessions], dim_date[is_cart_tracking_ok] = TRUE () )
// Format: #,0

[Sessions Viewed Product] =
CALCULATE ( [Sessions], fct_sessions[reached_view_item] = TRUE (), dim_date[is_cart_tracking_ok] = TRUE () )
// Format: #,0

[Sessions Added to Cart] =
CALCULATE ( [Sessions], fct_sessions[reached_add_to_cart] = TRUE (), dim_date[is_cart_tracking_ok] = TRUE () )
// Format: #,0

[Sessions Began Checkout] =
CALCULATE ( [Sessions], fct_sessions[reached_begin_checkout] = TRUE (), dim_date[is_cart_tracking_ok] = TRUE () )
// Format: #,0

[Sessions Purchased] =
CALCULATE ( [Sessions], fct_sessions[reached_purchase] = TRUE (), dim_date[is_cart_tracking_ok] = TRUE () )
// Format: #,0

[Funnel Sessions] =
SWITCH (
    SELECTEDVALUE ( dim_funnel_stage[stage_order] ),
    1, [Funnel Base Sessions],
    2, [Sessions Viewed Product],
    3, [Sessions Added to Cart],
    4, [Sessions Began Checkout],
    5, [Sessions Purchased]
)
// Format: #,0

[Funnel % of Sessions] =
DIVIDE (
    [Funnel Sessions],
    CALCULATE ( [Funnel Sessions], REMOVEFILTERS ( dim_funnel_stage ), dim_funnel_stage[stage_order] = 1 )
)
// Format: 0.0%

[Funnel Step Rate] =
VAR _stage = SELECTEDVALUE ( dim_funnel_stage[stage_order] )
RETURN
    IF (
        _stage > 1,
        DIVIDE (
            [Funnel Sessions],
            CALCULATE ( [Funnel Sessions], REMOVEFILTERS ( dim_funnel_stage ), dim_funnel_stage[stage_order] = _stage - 1 )
        )
    )
// Format: 0.0%

[Session to View Rate] =
DIVIDE ( [Sessions Viewed Product], [Funnel Base Sessions] )
// Format: 0.0%

[View to Cart Rate] =
DIVIDE ( [Sessions Added to Cart], [Sessions Viewed Product] )
// Format: 0.0%

[Cart to Checkout Rate] =
DIVIDE ( [Sessions Began Checkout], [Sessions Added to Cart] )
// Format: 0.0%

[Checkout to Purchase Rate] =
DIVIDE ( [Sessions Purchased], [Sessions Began Checkout] )
// Format: 0.0%


// ---------------------------------------------------------------- ATTRIBUTION

[Attributed Conversions] =
VAR _model = SELECTEDVALUE ( dim_attribution_model[model], "last_click" )
RETURN
    IF (
        _model = "markov",
        SUM ( attribution_markov[conversions] ),
        CALCULATE ( SUM ( fct_attribution_credits[credit] ), dim_attribution_model[model] = _model )
    )
// Format: #,0

[Attributed Revenue] =
VAR _model = SELECTEDVALUE ( dim_attribution_model[model], "last_click" )
RETURN
    IF (
        _model = "markov",
        SUM ( attribution_markov[revenue_usd] ),
        CALCULATE ( SUM ( fct_attribution_credits[revenue_credit_usd] ), dim_attribution_model[model] = _model )
    )
// Format: \$#,0

[Attributed Share] =
DIVIDE ( [Attributed Conversions], CALCULATE ( [Attributed Conversions], ALL ( dim_channel ) ) )
// Format: 0.0%

[Orders (Naive Last Click)] =
[Orders]
// Format: #,0

[Orders (Corrected Last Click)] =
CALCULATE ( SUM ( fct_attribution_credits[credit] ), dim_attribution_model[model] = "last_click" )
// Format: #,0

[Self-Referral Correction] =
[Orders (Corrected Last Click)] - [Orders (Naive Last Click)]
// Format: +#,0;-#,0;0

[Markov Share] =
SUM ( attribution_markov[share] )
// Format: 0.0%

[Markov Share CI Low] =
SUM ( attribution_markov[share_ci_low] )
// Format: 0.0%

[Markov Share CI High] =
SUM ( attribution_markov[share_ci_high] )
// Format: 0.0%

[Markov Conversions] =
SUM ( attribution_markov[conversions] )
// Format: #,0

[Markov vs Last Click] =
DIVIDE ( [Markov Conversions] - [Orders (Corrected Last Click)], [Orders (Corrected Last Click)] )
// Format: +0%;-0%;0%

[Markov 95% CI] =
IF ( NOT ISBLANK ( [Markov Share] ), FORMAT ( [Markov Share CI Low], "0.0%" ) & " to " & FORMAT ( [Markov Share CI High], "0.0%" ) )
// Format: text

[Self-Referral Orders] =
CALCULATE ( [Orders], dim_channel[channel] = "Internal Referral" )
// Format: #,0

[Self-Referral Share] =
DIVIDE ( [Self-Referral Orders], [Orders] )
// Format: 0.0%

[Organic Search Markov Share] =
CALCULATE ( [Markov Share], dim_channel[channel] = "Organic Search" )
// Format: 0.0%

[Paid Search Markov Uplift] =
CALCULATE ( [Markov vs Last Click], dim_channel[channel] = "Paid Search" )
// Format: +0%;-0%;0%


// ---------------------------------------------------------------- CUSTOMERS

[Customers] =
COUNTROWS ( dim_customers )
// Format: #,0

[Repeat Customer Rate] =
DIVIDE ( CALCULATE ( [Customers], dim_customers[buying_days] >= 2 ), [Customers] )
// Format: 0.0%

[Median Customer Spend] =
MEDIAN ( dim_customers[revenue_usd] )
// Format: \$#,0

[Average Customer Spend] =
AVERAGE ( dim_customers[revenue_usd] )
// Format: \$#,0

[Customer Revenue] =
SUM ( dim_customers[revenue_usd] )
// Format: \$#,0

[Share of Customers] =
DIVIDE ( [Customers], CALCULATE ( [Customers], REMOVEFILTERS ( dim_customers[rfm_segment] ) ) )
// Format: 0.0%

[Share of Revenue] =
DIVIDE ( [Customer Revenue], CALCULATE ( [Customer Revenue], REMOVEFILTERS ( dim_customers[rfm_segment] ) ) )
// Format: 0.0%

[Big Spender Revenue Share] =
CALCULATE ( [Share of Revenue], dim_customers[rfm_segment] = "Big one-off spenders" )
// Format: 0.0%

[Repeat Buyers] =
CALCULATE ( [Customers], dim_customers[buying_days] >= 2 )
// Format: #,0

[Back Within 14 Days] =
DIVIDE ( CALCULATE ( [Repeat Buyers], dim_customers[days_to_repeat] <= 14 ), [Repeat Buyers] )
// Format: 0.0%

[Repeat Within 7 Days] =
VAR _cut = DATE ( 2021, 1, 31 ) - 7
VAR _eligible = CALCULATE ( [Customers], KEEPFILTERS ( dim_customers[first_order_date] <= _cut ) )
RETURN
    IF (
        _eligible >= 100,
        DIVIDE (
            CALCULATE ( [Repeat Buyers], dim_customers[days_to_repeat] <= 7,
                        KEEPFILTERS ( dim_customers[first_order_date] <= _cut ) ),
            _eligible
        )
    )
// Format: 0.0%

[Repeat Within 14 Days] =
VAR _cut = DATE ( 2021, 1, 31 ) - 14
VAR _eligible = CALCULATE ( [Customers], KEEPFILTERS ( dim_customers[first_order_date] <= _cut ) )
RETURN
    IF (
        _eligible >= 100,
        DIVIDE (
            CALCULATE ( [Repeat Buyers], dim_customers[days_to_repeat] <= 14,
                        KEEPFILTERS ( dim_customers[first_order_date] <= _cut ) ),
            _eligible
        )
    )
// Format: 0.0%

[Repeat Within 30 Days] =
VAR _cut = DATE ( 2021, 1, 31 ) - 30
VAR _eligible = CALCULATE ( [Customers], KEEPFILTERS ( dim_customers[first_order_date] <= _cut ) )
RETURN
    IF (
        _eligible >= 100,
        DIVIDE (
            CALCULATE ( [Repeat Buyers], dim_customers[days_to_repeat] <= 30,
                        KEEPFILTERS ( dim_customers[first_order_date] <= _cut ) ),
            _eligible
        )
    )
// Format: 0.0%

[Eligible Customers 30 Days] =
CALCULATE ( [Customers], KEEPFILTERS ( dim_customers[first_order_date] <= DATE ( 2021, 1, 1 ) ) )
// Format: #,0

[Segment Action] =
SWITCH (
    SELECTEDVALUE ( dim_customers[rfm_segment] ),
    "Big one-off spenders", "Thank-you and a second-purchase offer within two weeks",
    "At risk", "One win-back email with a real reason to return",
    "Repeat, lapsing", "Personal note featuring their past categories",
    "Low-value one-offs", "No paid retargeting",
    "New customers", "Onboarding emails: the best chance of a second order",
    "Champions", "Early access and loyalty perks"
)
// Format: text


// ---------------------------------------------------------------- SALES

[Revenue per Clean Day] =
DIVIDE ( CALCULATE ( [Revenue], dim_date[is_revenue_tracking_ok] = TRUE () ), CALCULATE ( COUNTROWS ( dim_date ), dim_date[is_revenue_tracking_ok] = TRUE () ) )
// Format: \$#,0


// ---------------------------------------------------------------- ATTRIBUTION

[Single-Visit Order Share] =
DIVIDE (
    CALCULATE ( SUM ( fct_attribution_credits[credit] ), fct_attribution_credits[model] = "last_click",
                fct_attribution_credits[touches_in_path] = 1 ),
    CALCULATE ( SUM ( fct_attribution_credits[credit] ), fct_attribution_credits[model] = "last_click" )
)
// Format: 0.0%

[Organic Search Markov CI] =
"95% interval " & CALCULATE ( [Markov 95% CI], dim_channel[channel] = "Organic Search" )
// Format: text


// ---------------------------------------------------------------- FUNNEL

[Step Base Sessions] =
VAR _stage = SELECTEDVALUE ( dim_funnel_stage[stage_order] )
RETURN
    IF (
        _stage > 1,
        CALCULATE ( [Funnel Sessions], REMOVEFILTERS ( dim_funnel_stage ), dim_funnel_stage[stage_order] = _stage - 1 )
    )
// Format: #,0

[Desktop Step Rate] =
CALCULATE ( [Funnel Step Rate], dim_device[device_category] = "desktop" )
// Format: 0.0%

[Mobile Step Rate] =
CALCULATE ( [Funnel Step Rate], dim_device[device_category] = "mobile" )
// Format: 0.0%

[Mobile Minus Desktop] =
VAR _d = [Mobile Step Rate] - [Desktop Step Rate]
RETURN
    IF ( NOT ISBLANK ( [Mobile Step Rate] ), FORMAT ( _d * 100, "+0.0;-0.0;0.0" ) & " pts" )
// Format: text

[Mobile Minus Desktop CI] =
VAR _pm = [Mobile Step Rate]
VAR _pd = [Desktop Step Rate]
VAR _nm = CALCULATE ( [Step Base Sessions], dim_device[device_category] = "mobile" )
VAR _nd = CALCULATE ( [Step Base Sessions], dim_device[device_category] = "desktop" )
VAR _d = _pm - _pd
VAR _se = SQRT ( DIVIDE ( _pm * ( 1 - _pm ), _nm ) + DIVIDE ( _pd * ( 1 - _pd ), _nd ) )
RETURN
    IF (
        NOT ISBLANK ( _pm ),
        FORMAT ( ( _d - 1.96 * _se ) * 100, "+0.0;-0.0;0.0" ) & " to "
            & FORMAT ( ( _d + 1.96 * _se ) * 100, "+0.0;-0.0;0.0" ) & " pts"
    )
// Format: text

[Purchase Sessions] =
CALCULATE ( [Sessions], fct_sessions[reached_purchase] = TRUE () )
// Format: #,0

[Session Purchase Rate] =
DIVIDE ( [Purchase Sessions], [Sessions] )
// Format: 0.00%


// ---------------------------------------------------------------- TRAFFIC

[Landing Session Share] =
DIVIDE ( [Sessions], CALCULATE ( [Sessions], REMOVEFILTERS ( fct_sessions[landing_page_group] ) ) )
// Format: 0.0%


// ---------------------------------------------------------------- FUNNEL

[Session Purchase Rate CI] =
VAR _n = [Sessions]
VAR _k = [Purchase Sessions]
VAR _z = 1.96
VAR _p = DIVIDE ( _k, _n )
VAR _centre = ( _p + _z * _z / ( 2 * _n ) ) / ( 1 + _z * _z / _n )
VAR _half = _z * SQRT ( _p * ( 1 - _p ) / _n + _z * _z / ( 4 * _n * _n ) ) / ( 1 + _z * _z / _n )
RETURN
    IF ( _n > 0, FORMAT ( _centre - _half, "0.00%" ) & " to " & FORMAT ( _centre + _half, "0.00%" ) )
// Format: text


// ---------------------------------------------------------------- SALES

[Orders (Clean Value Days)] =
CALCULATE ( [Orders], dim_date[is_revenue_tracking_ok] = TRUE () )
// Format: #,0

[Median Order Value] =
CALCULATE ( MEDIAN ( fct_orders[purchase_revenue_usd] ), dim_date[is_revenue_tracking_ok] = TRUE () )
// Format: \$#,0

[Mean Order Value] =
CALCULATE ( [AOV], dim_date[is_revenue_tracking_ok] = TRUE () )
// Format: \$#,0

[Multi-Product Order Share] =
DIVIDE (
    CALCULATE ( [Orders], fct_orders[basket_type] = "Several products" ),
    CALCULATE ( [Orders], fct_orders[basket_type] <> "No item detail" )
)
// Format: 0.0%

[Top Decile Order Revenue Share] =
VAR _orders = CALCULATETABLE ( fct_orders, dim_date[is_revenue_tracking_ok] = TRUE () )
VAR _top = TOPN ( INT ( COUNTROWS ( _orders ) * 0.1 ), _orders, fct_orders[purchase_revenue_usd], DESC )
RETURN
    DIVIDE ( SUMX ( _top, fct_orders[purchase_revenue_usd] ), SUMX ( _orders, fct_orders[purchase_revenue_usd] ) )
// Format: 0.0%


// ---------------------------------------------------------------- PRODUCTS

[Product Orders] =
DISTINCTCOUNT ( fct_order_items[order_id] )
// Format: #,0

[Product Revenue Share] =
DIVIDE (
    SUM ( fct_order_items[item_revenue_usd] ),
    CALCULATE ( SUM ( fct_order_items[item_revenue_usd] ),
                REMOVEFILTERS ( fct_order_items[item_name], fct_order_items[item_category] ) )
)
// Format: 0.0%

[Pair Orders] =
SUM ( mart_product_pairs[orders_together] )
// Format: #,0

[Pair Lift] =
SUM ( mart_product_pairs[lift] )
// Format: 0.0


// ---------------------------------------------------------------- FORMATTING

[Apparel Highlight Color] =
IF ( SELECTEDVALUE ( fct_order_items[item_category] ) = "Apparel", "#BF616A", "#CED6E2" )
// Format: text

[Channel Highlight Color] =
IF ( SELECTEDVALUE ( dim_channel[channel] ) = "Organic Search", "#BF616A", "#CED6E2" )
// Format: text

[Referral Highlight Color] =
IF ( SELECTEDVALUE ( dim_channel[channel] ) = "Referral", "#BF616A", "#CED6E2" )
// Format: text

[January Highlight Color] =
IF ( SELECTEDVALUE ( dim_date[month_label] ) = "Jan 2021", "#BF616A", "#CED6E2" )
// Format: text

[Country Highlight Color] =
IF ( SELECTEDVALUE ( fct_sessions[geo_country] ) = "United States", "#BF616A", "#CED6E2" )
// Format: text


// ---------------------------------------------------------------- TRAFFIC

[Top 8 Country Share] =
VAR _rank = RANKX ( ALLSELECTED ( fct_sessions[geo_country] ), [Sessions] )
RETURN
    IF ( _rank <= 8, [Session Share] )
// Format: 0.0%


// ---------------------------------------------------------------- PERIOD COMPARISON

[Revenue PP] =
VAR _start = MIN ( dim_date[date] )
VAR _days = INT ( MAX ( dim_date[date] ) - _start ) + 1
RETURN
    CALCULATE ( [Revenue], DATESBETWEEN ( dim_date[date], _start - _days, _start - 1 ) )
// Format: \$#,0

[Revenue Change] =
VAR _cur = [Revenue]
VAR _pp = [Revenue PP]
RETURN
    IF (
        ISBLANK ( _pp ),
        "No prior period",
        IF ( _cur >= _pp, "▲ ", "▼ " ) & FORMAT ( ABS ( DIVIDE ( _cur - _pp, _pp ) ), "0.0%" ) & " vs previous period"
    )
// Format: text


// ---------------------------------------------------------------- FORMATTING

[Revenue Change Color] =
VAR _cur = [Revenue]
VAR _pp = [Revenue PP]
RETURN
    IF ( ISBLANK ( _pp ), "#5C667A", IF ( _cur >= _pp, "#4A7336", "#A3434C" ) )
// Format: text


// ---------------------------------------------------------------- PERIOD COMPARISON

[Orders PP] =
VAR _start = MIN ( dim_date[date] )
VAR _days = INT ( MAX ( dim_date[date] ) - _start ) + 1
RETURN
    CALCULATE ( [Orders], DATESBETWEEN ( dim_date[date], _start - _days, _start - 1 ) )
// Format: #,0

