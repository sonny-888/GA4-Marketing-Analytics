VAR _days = INT ( MAX ( dim_date[date] ) - _start ) + 1
RETURN
    CALCULATE ( [Cart to Checkout Rate], DATESBETWEEN ( dim_date[date], _start - _days, _start - 1 ) )
// Format: 0.0%

[Cart to Checkout Rate Change] =
VAR _cur = [Cart to Checkout Rate]
VAR _pp = [Cart to Checkout Rate PP]
RETURN
    IF (
        ISBLANK ( _pp ),
        "No prior period",
        IF ( _cur >= _pp, "▲ ", "▼ " ) & FORMAT ( ABS ( _cur - _pp ) * 100, "0.00" ) & " pts" & " vs previous period"
    )
// Format: text


