        ISBLANK ( _pp ),
        "No prior period",
        IF ( _cur >= _pp, "▲ ", "▼ " ) & FORMAT ( ABS ( _cur - _pp ) * 100, "0.00" ) & " pts" & " vs previous period"
    )
// Format: text


// ---------------------------------------------------------------- FORMATTING

[Session to View Rate Change Color] =
VAR _cur = [Session to View Rate]
VAR _pp = [Session to View Rate PP]
RETURN
    IF ( ISBLANK ( _pp ), "#5C667A", IF ( _cur >= _pp, "#4A7336", "#A3434C" ) )
// Format: text


// ---------------------------------------------------------------- PERIOD COMPARISON

[View to Cart Rate PP] =
VAR _start = MIN ( dim_date[date] )
VAR _days = INT ( MAX ( dim_date[date] ) - _start ) + 1
RETURN
    CALCULATE ( [View to Cart Rate], DATESBETWEEN ( dim_date[date], _start - _days, _start - 1 ) )
// Format: 0.0%

[View to Cart Rate Change] =
VAR _cur = [View to Cart Rate]
VAR _pp = [View to Cart Rate PP]
RETURN
    IF (
        ISBLANK ( _pp ),
        "No prior period",
        IF ( _cur >= _pp, "▲ ", "▼ " ) & FORMAT ( ABS ( _cur - _pp ) * 100, "0.00" ) & " pts" & " vs previous period"
    )
// Format: text


// ---------------------------------------------------------------- FORMATTING

[View to Cart Rate Change Color] =
VAR _cur = [View to Cart Rate]
VAR _pp = [View to Cart Rate PP]
RETURN
    IF ( ISBLANK ( _pp ), "#5C667A", IF ( _cur >= _pp, "#4A7336", "#A3434C" ) )
// Format: text


// ---------------------------------------------------------------- PERIOD COMPARISON

[Cart to Checkout Rate PP] =
